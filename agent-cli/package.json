{
  "name": "sublera-cli",
  "version": "1.3.0",
  "description": "Sublera GPU host terminal agent: run llama.cpp, serve metered tokens, and survive overnight bookings.",
  "author": "Sublera contributors",
  "homepage": "https://github.com/somemusic69-sudo/Sublet-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somemusic69-sudo/Sublet-cli.git",
    "directory": "agent-cli"
  },
  "bugs": {
    "url": "https://github.com/somemusic69-sudo/Sublet-cli/issues"
  },
  "type": "module",
  "bin": {
    "sublera": "dist/index.js",
    "sublera-cli": "dist/index.js",
    "sublet": "dist/index.js",
    "sublet-cli": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "keywords": [
    "sublera",
    "gpu",
    "llama.cpp",
    "gguf",
    "openai",
    "npx"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --test-timeout=120000 --test-force-exit tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=src/**/*.ts tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-package.mjs",
    "e2e": "node scripts/e2e.mjs",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "tar": "^7.4.3",
    "undici": "^7.30.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^26.6.6",
    "@types/tar": "^7.0.87",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2"
  }
}
